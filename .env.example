# Vercel Marketplace -> Neon supplies this automatically after integration.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# One shared apartment password. Keep it server-side only.
HOUSEHOLD_PASSWORD=change-this-to-a-strong-shared-password

# Long random secret used to sign the secure login cookie.
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret
